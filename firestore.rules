rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create, update, delete: if admin(); }
    match /properties/{id} { allow read: if resource.data.publicationStatus == 'published' || admin(); allow create, update, delete: if admin(); }
    match /siteContent/{id} { allow read: if true; allow write: if admin(); }
    match /inquiries/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /clients/{id} { allow read, write: if admin(); }
    match /propertyLeads/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /valuations/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /activityLogs/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
