rules_version = '2';
service firebase.storage { match /b/{bucket}/o { function admin(){return request.auth!=null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role=='admin'} match /properties/{propertyId}/{file}{allow read: if true; allow write: if admin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');} match /articles/{articleId}/{file}{allow read: if true; allow write: if admin();} match /site/{file}{allow read: if true; allow write: if admin();} match /profiles/{userId}/{file}{allow read: if request.auth!=null && request.auth.uid==userId || admin(); allow write: if request.auth!=null && request.auth.uid==userId || admin();} match /insurance-requests/{requestId}/{file}{allow read,write: if admin();} match /real-estate-leads/{leadId}/{file}{allow read,write: if admin();} } }
