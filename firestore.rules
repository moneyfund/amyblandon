rules_version = '2';
service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth!=null} function admin(){return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin'} match /properties/{id}{allow read: if resource.data.published==true || admin(); allow write: if admin();} match /articles/{id}{allow read: if resource.data.published==true || admin(); allow write: if admin();} match /testimonials/{id}{allow read: if resource.data.published==true || admin(); allow write: if admin();} match /siteSettings/{id}{allow read: if true; allow write: if admin();} match /users/{id}{allow read: if admin() || request.auth.uid==id; allow write: if admin();} match /{leadCollection}/{id}{allow create: if leadCollection in ['realEstateLeads','insuranceRequests','contacts','appointments']; allow read,update,delete: if admin();} } }
